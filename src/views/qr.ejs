<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet">
    <title>Aydo</title>
    <style>
        body {
            background-color: #FBFEF4;
        }

        body * {
            color: #060022;
            font-family: "IBM Plex Mono", monospace;
        }

        .content {
            width: 100vw;
            height: 100vh;

            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 50px;
        }

        .title {
            margin: 0;
            text-align: center;
            font-size: 22px;
        }

        span {
            font-size: 16px;
        }

        .copy-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input {
            position: relative;
        }

        .copy-container input {
            padding: 16px 125px 16px 12px;
            width: 360px;
            font-size: 16px;
            border: 1px solid #060022;
            border-radius: 8px;
            background-color: transparent;
            user-select: none;
        }

        .copy-container button {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            right: 0;
            padding: 16px 30px;
            height: 100%;
            min-width: 116px;
            color: white;
            background-color: #060022;
            border: none;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
            transition: font-size 0.3s ease;
        }

        .logo {
            background: transparent;
            margin-bottom: 20px;
        }

        .store-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            justify-content: center;
            align-items: center;
        }

        .store-buttons img {
            height: 40px;
            width: auto;
        }
    </style>
</head>

<body>
    <div class="content">
        <a href="https://www.aydo.ai/" target="_blank">
            <img src="/logo.svg" alt="Aydo Logo" width="64" class="logo" />
        </a>
        <h4 class="title">Please, scan this QR-code in the application</h4>
        <img src="<%= url %>" alt="" />
        <span>or enter this fields manually:</span>
        <div class="copy-container">
            <label>Hub identifier: </label>
            <div class="input">
                <input type="text" id="identifier" value="<%= identifier %>">
                <button onclick="copyText('identifier', this)">copy</button>
            </div>
        </div>
        <div class="copy-container">
            <label>Hub token:</label>
            <div class="input">
                <input type="text" id="token" value="<%= token %>">
                <button onclick="copyText('token', this)">copy</button>
            </div>
        </div>

        <div class="store-buttons">
            <a href="#googleplay" target="_blank">
                <img src="/google-badge.png" alt="Available in Google Play">
            </a>
            <a href="#appstore" target="_blank">
                <img src="/apple-badge.svg" alt="Download in App Store">
            </a>
        </div>
    </div>
    <script>
        function copyText(el, btn) {
            const element = document.getElementById(el);
            if (!element) {
                console.error('element not found');
                return;
            }
            const text = element.value || element.innerText || element.textContent;
            if (!text) {
                console.error('text not found');
                return;
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    btn.innerText = 'copied!';
                    setTimeout(() => {
                        btn.innerText = 'copy';
                    }, 1000);
                }).catch(err => {
                    console.error(err);
                });
            } else {
                const textArea = document.createElement('textarea');
                textArea.value = text;
                textArea.style.position = 'fixed';
                document.body.appendChild(textArea);
                textArea.select();
                textArea.setSelectionRange(0, 99999);
                try {
                    document.execCommand('copy');
                    btn.innerText = 'copied!';
                    setTimeout(() => {
                        btn.innerText = 'copy';
                    }, 1000);
                } catch (e) {
                    console.error(e);
                }
                document.body.removeChild(textArea);
            }
        }
    </script>
</body>

</html>